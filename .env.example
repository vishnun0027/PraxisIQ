# --- Database Configuration (Supabase) ---
# Use Transaction Pooler URI (port 6543) or Direct URI from Supabase Project Settings -> Database -> Connection string -> URI
DATABASE_URL=postgresql+psycopg://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require

# --- LLM Configuration (Groq Cloud) ---
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Telegram Bot Integration (Collector) ---
# Token given by @BotFather upon creating a bot
TELEGRAM_BOT_TOKEN=1234567890:ABCDEFGHIJKLMNOPQRSTUVWXYZ
# Your private user Chat ID to lock ingestion down strictly to your account
# Get your ID by messaging @userinfobot or @chatIDrobot on Telegram
TELEGRAM_ALLOWED_CHAT_ID=987654321

# --- Future Proof SDK Support (Optional) ---
SUPABASE_URL=https://[YOUR_PROJECT_REF].supabase.co
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

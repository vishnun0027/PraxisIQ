[Unit]
Description=PraxisIQ Embedding Server
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/vishnu/worklab/praxisiq
EnvironmentFile=/home/vishnu/worklab/praxisiq/.env
Environment=PYTHONPATH=/home/vishnu/worklab/praxisiq
ExecStart=/home/vishnu/worklab/praxisiq/.venv/bin/python src/embed_server.py
Restart=always
RestartSec=5

[Install]
WantedBy=default.target

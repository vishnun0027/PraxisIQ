[Unit]
Description=PraxisIQ Telegram Collector Bot
After=network.target praxisiq-embed.service
Wants=praxisiq-embed.service

[Service]
Type=simple
WorkingDirectory=/home/vishnu/worklab/praxisiq
EnvironmentFile=/home/vishnu/worklab/praxisiq/.env
Environment=PYTHONPATH=/home/vishnu/worklab/praxisiq
ExecStart=/home/vishnu/worklab/praxisiq/.venv/bin/python src/bot/collector.py
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
